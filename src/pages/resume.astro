---
import Base from "../layouts/Base.astro";
---

<Base title="Resume | Cameron Stewart">
	<div class="resume-container">
		<!-- Top Bar -->
		<div class="resume-topbar">
			<a href="/" class="back-link">&larr; Back to Home</a>
			<button 
				id="open-download-modal-btn" 
				class="download-btn"
				type="button"
			>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
					<polyline points="7 10 12 15 17 10"></polyline>
					<line x1="12" y1="15" x2="12" y2="3"></line>
				</svg>
				Download PDF
			</button>
		</div>

		<!-- Resume Header -->
		<header class="resume-header">
			<div>
				<h1 class="candidate-name">
					Cameron Stewart<span class="brand-dot">.</span>
				</h1>
				<p class="candidate-title">
					<span class="live-indicator"></span>
					Full Stack Software Engineer & Edge Architect
				</p>
			</div>
			<div class="contact-meta">
				<span>Searcy, Arkansas</span>
				<span>·</span>
				<a href="mailto:cg@rocktownlabs.com">cg@rocktownlabs.com</a>
				<span>·</span>
				<a href="https://github.com/cgRGM" target="_blank" rel="noopener noreferrer">github.com/cgRGM</a>
				<span>·</span>
				<a href="https://linkedin.com/in/camgstewart" target="_blank" rel="noopener noreferrer">linkedin.com/in/camgstewart</a>
			</div>
		</header>

		<!-- Executive Summary -->
		<section class="resume-section">
			<h2 class="section-title">
				<span>Summary</span>
				<span class="title-line"></span>
			</h2>
			<p class="summary-text">
				Full stack software engineer with 5+ years of experience designing, building, and operating high-performance consumer applications, distributed systems, and cloud infrastructure. Strong technical background spanning TypeScript, React, Node.js, and Hono, alongside modern C#/.NET and relational databases. Proven track record architecting edge compute on Cloudflare, scalable cloud infrastructure on AWS, and reliable payment systems with Stripe. Driven by high engineering velocity, automated CI/CD pipelines, and rigorous production correctness.
			</p>
		</section>

		<!-- Technical Skills -->
		<section class="resume-section">
			<h2 class="section-title">
				<span>Technical Skills</span>
				<span class="title-line"></span>
			</h2>
			<div class="skills-list">
				<p class="skill-line">
					<strong class="skill-category">Languages & Runtimes:</strong> TypeScript, JavaScript, C#, .NET, Python, Node.js, SQL, Bun
				</p>
				<p class="skill-line">
					<strong class="skill-category">Frontend & Frameworks:</strong> React, Next.js, TanStack Start, React Native (Expo), Astro, Hono, Tailwind CSS, shadcn/ui
				</p>
				<p class="skill-line">
					<strong class="skill-category">Edge & Cloud Infrastructure:</strong> Cloudflare (Workers, D1, R2, DO, Queues, Workflows), Alchemy, AWS (Lambda, CloudFront, S3, ECS), Docker, Vercel
				</p>
				<p class="skill-line">
					<strong class="skill-category">Databases & Storage:</strong> Cloudflare D1, Postgres, Redis, SQL Server, Convex
				</p>
				<p class="skill-line">
					<strong class="skill-category">Commerce & AI Systems:</strong> Stripe (Connect, Custom Payouts, Webhooks), Gemini Vision API, Workers AI, Polar, Shippo, Resend
				</p>
				<p class="skill-line">
					<strong class="skill-category">DevOps & Correctness:</strong> GitHub Actions CI/CD, Oxlint, Turborepo, Idempotency pipelines, Transactional outbox patterns, Sentry, PostHog
				</p>
			</div>
		</section>

		<!-- Work Experience -->
		<section class="resume-section">
			<h2 class="section-title">
				<span>Professional Experience</span>
				<span class="title-line"></span>
			</h2>

			<div class="experience-list">
				<!-- Rocktown Labs -->
				<article class="exp-item">
					<div class="exp-header">
						<div>
							<h3 class="exp-role">Lead Software Engineer</h3>
							<h4 class="exp-company">Rocktown Labs</h4>
						</div>
						<span class="exp-date">Jan 2023 – Present · Searcy, AR (Remote)</span>
					</div>
					<ul class="exp-bullets">
						<li>Architect, deploy, and operate live consumer products, multi-agent AI tooling, and business infrastructure with PR-driven automated workflows.</li>
						<li>Built <strong>SoundKit</strong>: creator-first music platform with Stripe Connect creator payouts, Cloudflare Durable Objects live audio rooms, Hyperdrive-pooled PostgreSQL, and WebCodecs playback.</li>
						<li>Engineered <strong>Big Brain Shelf</strong>: children’s bookstore and multi-agent AI book generation factory running on Astro + Cloudflare Workers with automated vision QC judges and Shippo fulfillment.</li>
						<li>Created <strong>QuickCalAI</strong>: subscription calendar extraction service with a custom Model Context Protocol (MCP) server exposing tools to external AI agents.</li>
						<li>Developed <strong>GigStax</strong>: gig economy tax tool with Cloudflare Workflows, Gemini vision extraction, and Polar billing.</li>
					</ul>
				</article>

				<!-- Dead Party Media -->
				<article class="exp-item">
					<div class="exp-header">
						<div>
							<h3 class="exp-role">Full Stack Developer</h3>
							<h4 class="exp-company">Dead Party Media & Arkansas Music Awards</h4>
						</div>
						<span class="exp-date">Jan 2024 – Present · Contract</span>
					</div>
					<ul class="exp-bullets">
						<li>Architect and maintain a Next.js 16 Turborepo monorepo and Expo mobile app powering an arts publication and live events ecosystem.</li>
						<li>Built high-throughput backend APIs with Drizzle over Neon Postgres, Clerk role-based auth, and Stripe ticketing supporting 20+ live productions.</li>
						<li>Implemented multi-publication editorial permission governance for writers, editors, and venue administrators.</li>
					</ul>
				</article>

				<!-- ATA International -->
				<article class="exp-item">
					<div class="exp-header">
						<div>
							<h3 class="exp-role">Web Developer & Software Administrator</h3>
							<h4 class="exp-company">ATA International</h4>
						</div>
						<span class="exp-date">Oct 2020 – Jan 2022 · Little Rock, AR</span>
					</div>
					<ul class="exp-bullets">
						<li>Developed and maintained <strong>C#/.NET backend services</strong> and SQL Server database schemas for an international martial arts education platform supporting 130,000+ active users.</li>
						<li>Engineered responsive instructor and student portal interfaces using React and modern JavaScript.</li>
						<li>Implemented secure remote video testing workflows to preserve school operations and rank testing during COVID-19.</li>
					</ul>
				</article>

				<!-- Fathom Realty -->
				<article class="exp-item">
					<div class="exp-header">
						<div>
							<h3 class="exp-role">Realtor & Software Automation Developer</h3>
							<h4 class="exp-company">Fathom Realty</h4>
						</div>
						<span class="exp-date">Aug 2021 – Jan 2023 · Contract</span>
					</div>
					<ul class="exp-bullets">
						<li>Built custom lead-generation scrapers and data aggregation pipelines for Realtor.com data across Arkansas, Missouri, and Louisiana.</li>
						<li>Constructed internal recruiting dashboards using Next.js and React, automating broker outreach and prospect management.</li>
					</ul>
				</article>
			</div>
		</section>

		<!-- Education & Certifications -->
		<section class="resume-section">
			<h2 class="section-title">
				<span>Education & Certifications</span>
				<span class="title-line"></span>
			</h2>
			<div class="edu-grid">
				<div class="edu-item">
					<h3 class="edu-degree">Bachelor of Science in Software Engineering</h3>
					<p class="edu-school">Western Governors University</p>
				</div>
				<div class="edu-item">
					<h3 class="edu-degree">AWS Certified Cloud Practitioner</h3>
					<p class="edu-school">Amazon Web Services (AWS)</p>
				</div>
			</div>
		</section>
	</div>

	<!-- Gated Download Modal -->
	<div id="resume-modal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="modal-title">
		<div class="modal-card">
			<button id="modal-close-btn" class="modal-close" type="button" aria-label="Close modal">&times;</button>
			<div class="modal-header">
				<h3 id="modal-title" class="modal-title">Download Resume (PDF)</h3>
				<p class="modal-desc">Please share your contact details below to receive Cameron's 1-page resume.</p>
			</div>
			<form id="resume-download-form" class="modal-form">
				<div class="form-group">
					<label for="form-name">Full Name <span class="optional">(optional)</span></label>
					<input type="text" id="form-name" name="name" placeholder="e.g. Alex Morgan" autocomplete="name" />
				</div>
				<div class="form-group">
					<label for="form-email">Work Email <span class="required">*</span></label>
					<input type="email" id="form-email" name="email" required placeholder="alex@company.com" autocomplete="email" />
				</div>
				<div class="form-group">
					<label for="form-phone">Phone Number <span class="required">*</span></label>
					<input type="tel" id="form-phone" name="phone" required placeholder="(555) 123-4567" autocomplete="tel" />
				</div>
				<div id="form-error" class="form-error hidden"></div>
				<button type="submit" id="form-submit-btn" class="btn-submit">
					Download 1-Page PDF &rarr;
				</button>
				<p class="form-privacy">Confidential. Used only to follow up with recruiters and hiring managers.</p>
			</form>
		</div>
	</div>
</Base>

<script>
	const modal = document.getElementById("resume-modal");
	const openBtn = document.getElementById("open-download-modal-btn");
	const closeBtn = document.getElementById("modal-close-btn");
	const form = document.getElementById("resume-download-form") as HTMLFormElement | null;
	const errorEl = document.getElementById("form-error");
	const submitBtn = document.getElementById("form-submit-btn") as HTMLButtonElement | null;

	function triggerDownload(url: string) {
		const a = document.createElement("a");
		a.href = url;
		a.download = "Cameron-Stewart-Resume.pdf";
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
	}

	function openModal() {
		if (localStorage.getItem("resume_granted") === "true") {
			triggerDownload("/Cameron-Stewart-Resume.pdf");
			return;
		}
		modal?.classList.remove("hidden");
	}

	function closeModal() {
		modal?.classList.add("hidden");
		if (errorEl) {
			errorEl.textContent = "";
			errorEl.classList.add("hidden");
		}
	}

	openBtn?.addEventListener("click", openModal);
	closeBtn?.addEventListener("click", closeModal);
	modal?.addEventListener("click", (e) => {
		if (e.target === modal) closeModal();
	});

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		const formData = new FormData(form);
		const data = {
			name: formData.get("name"),
			email: formData.get("email"),
			phone: formData.get("phone"),
		};

		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = "Processing...";
		}
		if (errorEl) {
			errorEl.textContent = "";
			errorEl.classList.add("hidden");
		}

		try {
			const res = await fetch("/api/resume-request", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(data),
			});
			const json = await res.json();
			if (!res.ok) {
				throw new Error(json.error || "Submission failed");
			}

			localStorage.setItem("resume_granted", "true");
			triggerDownload(json.downloadUrl || "/Cameron-Stewart-Resume.pdf");
			closeModal();
		} catch (err: any) {
			if (errorEl) {
				errorEl.textContent = err.message || "An error occurred. Please try again.";
				errorEl.classList.remove("hidden");
			}
		} finally {
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.textContent = "Download 1-Page PDF →";
			}
		}
	});
</script>

<style>
	.resume-container {
		max-width: 860px;
		margin: 0 auto;
		padding: 3rem 1.5rem 6rem;
	}

	.resume-topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 2.5rem;
	}

	.back-link {
		font-size: 0.875rem;
		color: var(--color-muted);
		text-decoration: none;
		font-weight: 500;
	}

	.back-link:hover {
		color: var(--color-brand);
	}

	.download-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.625rem 1.25rem;
		background: var(--color-brand);
		color: #ffffff;
		border-radius: 6px;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid var(--color-brand);
		cursor: pointer;
		transition: opacity 150ms ease, box-shadow 150ms ease;
	}

	.download-btn:hover {
		opacity: 0.92;
		box-shadow: 0 0 15px color-mix(in srgb, var(--color-brand) 35%, transparent);
	}

	.resume-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 1.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: 3rem;
	}

	.candidate-name {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 5vw, 3.25rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		margin: 0 0 0.5rem 0;
		color: var(--color-text);
	}

	.candidate-title {
		font-size: 1rem;
		color: var(--color-muted);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
	}

	.live-indicator {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #10b981;
		display: inline-block;
	}

	.contact-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--color-muted);
	}

	.contact-meta a {
		color: var(--color-text);
		text-decoration: none;
		transition: color 150ms ease;
	}

	.contact-meta a:hover {
		color: var(--color-brand);
	}

	.resume-section {
		margin-bottom: 3rem;
	}

	.section-title {
		font-family: var(--font-heading);
		font-size: 0.9375rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-brand);
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.title-line {
		flex: 1;
		height: 1px;
		background: var(--color-border);
	}

	.summary-text {
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--color-muted);
	}

	/* Technical Skills - Category: Skill 1, Skill 2 */
	.skills-list {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		padding: 1.5rem;
		border-radius: 8px;
	}

	.skill-line {
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--color-muted);
		margin: 0;
	}

	.skill-category {
		color: var(--color-text);
		font-weight: 600;
		margin-right: 0.35rem;
	}

	/* Experience */
	.experience-list {
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
	}

	.exp-item {
		border-left: 2px solid var(--color-border);
		padding-left: 1.5rem;
		position: relative;
	}

	.exp-item::before {
		content: "";
		position: absolute;
		left: -6px;
		top: 4px;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--color-brand);
	}

	.exp-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}

	.exp-role {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-text);
		margin: 0;
	}

	.exp-company {
		font-size: 0.9375rem;
		color: var(--color-brand);
		font-weight: 500;
		margin: 0.2rem 0 0 0;
	}

	.exp-date {
		font-size: 0.8125rem;
		color: var(--color-muted);
		font-family: monospace;
	}

	.exp-bullets {
		margin: 0;
		padding-left: 1.25rem;
		color: var(--color-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.exp-bullets li strong {
		color: var(--color-text);
	}

	/* Education */
	.edu-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: 1.5rem;
	}

	.edu-item {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		padding: 1.25rem;
		border-radius: 6px;
	}

	.edu-degree {
		font-size: 0.9375rem;
		font-weight: 700;
		color: var(--color-text);
		margin: 0 0 0.35rem 0;
	}

	.edu-school {
		font-size: 0.875rem;
		color: var(--color-muted);
		margin: 0;
	}

	/* Modal Backdrop & Card */
	.modal-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(4px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
		z-index: 1000;
	}

	.modal-backdrop.hidden {
		display: none;
	}

	.modal-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		width: 100%;
		max-width: 440px;
		padding: 2rem;
		position: relative;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		animation: modalFadeIn 150ms ease-out;
	}

	@keyframes modalFadeIn {
		from {
			opacity: 0;
			transform: scale(0.96);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	.modal-close {
		position: absolute;
		top: 1rem;
		right: 1.25rem;
		background: transparent;
		border: none;
		font-size: 1.75rem;
		line-height: 1;
		color: var(--color-muted);
		cursor: pointer;
		padding: 0.25rem;
		transition: color 150ms ease;
	}

	.modal-close:hover {
		color: var(--color-text);
	}

	.modal-header {
		margin-bottom: 1.5rem;
	}

	.modal-title {
		font-family: var(--font-heading);
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--color-text);
		margin: 0 0 0.5rem 0;
	}

	.modal-desc {
		font-size: 0.875rem;
		color: var(--color-muted);
		line-height: 1.5;
		margin: 0;
	}

	.modal-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.form-group label {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.form-group label .required {
		color: #ef4444;
	}

	.form-group label .optional {
		color: var(--color-muted);
		font-weight: 400;
		font-size: 0.75rem;
	}

	.form-group input {
		width: 100%;
		padding: 0.65rem 0.85rem;
		background: color-mix(in srgb, var(--color-bg) 60%, var(--color-surface));
		border: 1px solid var(--color-border);
		border-radius: 6px;
		color: var(--color-text);
		font-size: 0.9375rem;
		font-family: inherit;
		transition: border-color 150ms ease;
	}

	.form-group input:focus {
		outline: none;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-brand) 25%, transparent);
	}

	.form-error {
		font-size: 0.8125rem;
		color: #ef4444;
		padding: 0.5rem;
		background: rgba(239, 68, 68, 0.1);
		border-radius: 4px;
		border: 1px solid rgba(239, 68, 68, 0.2);
	}

	.form-error.hidden {
		display: none;
	}

	.btn-submit {
		margin-top: 0.5rem;
		padding: 0.75rem 1.25rem;
		background: var(--color-brand);
		color: #ffffff;
		border: none;
		border-radius: 6px;
		font-family: var(--font-heading);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		cursor: pointer;
		transition: opacity 150ms ease, box-shadow 150ms ease;
	}

	.btn-submit:hover:not(:disabled) {
		opacity: 0.92;
		box-shadow: 0 0 15px color-mix(in srgb, var(--color-brand) 35%, transparent);
	}

	.btn-submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.form-privacy {
		font-size: 0.75rem;
		color: var(--color-muted);
		text-align: center;
		margin: 0.25rem 0 0 0;
	}

	@media (max-width: 640px) {
		.resume-container {
			padding: 2rem 1.125rem 3.5rem;
		}

		.resume-topbar {
			margin-bottom: 1.75rem;
		}

		.skills-list {
			padding: 1.125rem;
		}

		.exp-item {
			padding-left: 1.125rem;
		}

		.modal-card {
			padding: 1.5rem;
			max-height: 90dvh;
			overflow-y: auto;
		}
	}
</style>
