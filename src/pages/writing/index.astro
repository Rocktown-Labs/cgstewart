---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

const postsResult = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});

const posts = postsResult.entries || [];
---

<Base title="Writing · cgstewart.dev">
	<div class="writing-page">
		<header class="writing-header">
			<h1 class="page-title">
				Writing<span class="brand-dot">.</span>
			</h1>
			<p class="page-desc">
				Essays, architecture decisions, and real production engineering notes across full-stack TypeScript, edge runtimes, and C#/.NET.
			</p>
		</header>

		<div class="posts-list">
			{
				posts.map((post) => (
					<a href={`/writing/${post.slug}`} class="post-item">
						<div class="post-date">{post.data.published_date || "2026"}</div>
						<div class="post-info">
							<h2 class="post-title">{post.data.title}</h2>
							<p class="post-summary">{post.data.summary}</p>
						</div>
						<div class="post-arrow">&rarr;</div>
					</a>
				))
			}
		</div>
	</div>
</Base>

<style>
	.writing-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 3rem 1.5rem 6rem;
	}

	.writing-header {
		margin-bottom: 3.5rem;
	}

	.page-title {
		font-family: var(--font-heading);
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 800;
		text-transform: uppercase;
		margin: 0 0 0.75rem 0;
		color: var(--color-text);
	}

	.page-desc {
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--color-muted);
		max-width: 720px;
		margin: 0;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.post-item {
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		border-radius: 8px;
		text-decoration: none;
		transition: all 150ms ease;
	}

	.post-item:hover {
		border-color: var(--color-brand);
		transform: translateX(4px);
	}

	.post-date {
		font-family: monospace;
		font-size: 0.8125rem;
		color: var(--color-muted);
		min-width: 95px;
	}

	.post-info {
		flex: 1;
	}

	.post-title {
		font-family: var(--font-heading);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-text);
		margin: 0 0 0.35rem 0;
	}

	.post-summary {
		font-size: 0.9375rem;
		color: var(--color-muted);
		margin: 0;
		line-height: 1.5;
	}

	.post-arrow {
		color: var(--color-brand);
		font-size: 1.25rem;
		font-weight: 700;
	}

	@media (max-width: 640px) {
		.writing-page {
			padding: 2rem 1.125rem 3.5rem;
		}

		.writing-header {
			margin-bottom: 2rem;
		}

		.post-item {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
			padding: 1.125rem;
		}

		.post-arrow {
			display: none;
		}
	}
</style>
