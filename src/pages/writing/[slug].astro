---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import { marked } from "marked";

const { slug } = Astro.params;

const postsResult = await getEmDashCollection("posts", {
	limit: 100,
});

const post = (postsResult.entries || []).find((p) => p.slug === slug || p.id === slug);

if (!post) {
	return Astro.redirect("/writing");
}

let contentHtml = "";
if (typeof post.data.content === "string") {
	contentHtml = await marked.parse(post.data.content);
} else if (Array.isArray(post.data.content)) {
	const rawText = post.data.content
		.map((block: any) => {
			if (block._type === "block" && block.children) {
				return block.children.map((c: any) => c.text).join("");
			}
			return "";
		})
		.filter(Boolean)
		.join("\n\n");
	contentHtml = await marked.parse(rawText);
}
---

<Base title={`${post.data.title} | cgstewart.dev`}>
	<article class="post-detail-page">
		<nav class="back-nav">
			<a href="/writing" class="back-link">
				<span class="back-dash"></span>
				back to all writing
			</a>
		</nav>

		<header class="post-header">
			<div class="post-meta">
				<span class="post-date">{post.data.published_date || "2026"}</span>
				<span>·</span>
				<span>Cameron Stewart</span>
			</div>
			<h1 class="post-title">
				{post.data.title}<span class="brand-dot">.</span>
			</h1>
			{post.data.summary && <p class="post-lead">{post.data.summary}</p>}
		</header>

		<div class="post-body markdown-body">
			{
				contentHtml ? (
					<div set:html={contentHtml} />
				) : (
					<p class="placeholder-text">Draft in progress.</p>
				)
			}
		</div>
	</article>
</Base>

<style>
	.post-detail-page {
		max-width: 780px;
		margin: 0 auto;
		padding: 3rem 1.5rem 6rem;
	}

	.back-nav {
		margin-bottom: 2.5rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		font-family: var(--font-heading);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--color-muted);
		text-decoration: none;
		transition: color 150ms ease;
	}

	.back-dash {
		display: inline-block;
		width: 1rem;
		height: 1px;
		background: var(--color-muted);
		transition: background-color 150ms ease;
	}

	.back-link:hover {
		color: var(--color-brand);
	}

	.back-link:hover .back-dash {
		background: var(--color-brand);
	}

	.post-header {
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 2.5rem;
		margin-bottom: 3rem;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
		font-family: monospace;
		color: var(--color-muted);
		margin-bottom: 1rem;
	}

	.post-title {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 5vw, 3.25rem);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: -0.03em;
		line-height: 1.15;
		margin: 0 0 1.25rem 0;
		color: var(--color-text);
	}

	.post-lead {
		font-size: 1.125rem;
		line-height: 1.7;
		color: var(--color-muted);
		margin: 0;
	}

	.post-body {
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--color-text);
		overflow-wrap: anywhere;
	}

	/* Markdown typography */
	.markdown-body :global(h2) {
		font-family: var(--font-heading);
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-top: 2.75rem;
		margin-bottom: 1rem;
		color: var(--color-text);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 0.4rem;
	}

	.markdown-body :global(h3) {
		font-family: var(--font-heading);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		color: var(--color-text);
	}

	.markdown-body :global(p) {
		margin-bottom: 1.5rem;
		color: color-mix(in srgb, var(--color-text) 90%, transparent);
	}

	.markdown-body :global(ul),
	.markdown-body :global(ol) {
		padding-left: 1.5rem;
		margin-bottom: 1.5rem;
		color: color-mix(in srgb, var(--color-text) 88%, transparent);
	}

	.markdown-body :global(li) {
		margin-bottom: 0.5rem;
	}

	.markdown-body :global(blockquote) {
		border-left: 3px solid var(--color-brand);
		background: color-mix(in srgb, var(--color-brand) 6%, transparent);
		padding: 1rem 1.25rem;
		margin: 2rem 0;
		border-radius: 0 6px 6px 0;
		font-style: italic;
		color: var(--color-muted);
	}

	.markdown-body :global(pre) {
		background: #0d0d0d;
		border: 1px solid var(--color-border);
		padding: 1.25rem 1.5rem;
		border-radius: 8px;
		overflow-x: auto;
		margin: 2rem 0;
	}

	.markdown-body :global(code) {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.875em;
		color: var(--color-brand);
	}

	.markdown-body :global(pre code) {
		color: #e4e4e7;
	}

	.markdown-body :global(img) {
		width: 100%;
		height: auto;
		border-radius: 8px;
		border: 1px solid var(--color-border);
		margin: 2rem 0 1rem;
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
		background: #000;
	}

	.markdown-body :global(hr) {
		border: none;
		border-top: 1px solid var(--color-border);
		margin: 3rem 0;
	}

	.markdown-body :global(strong) {
		color: var(--color-text);
		font-weight: 600;
	}

	.markdown-body :global(a) {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	@media (max-width: 640px) {
		.post-detail-page {
			padding: 1.75rem 1.125rem 3.5rem;
		}

		.post-header {
			padding-bottom: 1.75rem;
			margin-bottom: 2rem;
		}
	}
</style>
