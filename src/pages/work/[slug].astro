---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import { marked } from "marked";

const { slug } = Astro.params;

const projectsResult = await getEmDashCollection("projects", {
	limit: 100,
});

const project = (projectsResult.entries || []).find((p) => p.slug === slug || p.id === slug);

if (!project) {
	return Astro.redirect("/work");
}

const repo = project.data.github_repo;
let readmeHtml = "";
let fetchError = false;

if (repo) {
	try {
		// Try 'main' branch first, then 'master'
		let res = await fetch(`https://raw.githubusercontent.com/${repo}/main/README.md`);
		if (!res.ok) {
			res = await fetch(`https://raw.githubusercontent.com/${repo}/master/README.md`);
		}
		if (res.ok) {
			const md = await res.text();
			readmeHtml = await marked.parse(md);
		} else {
			fetchError = true;
		}
	} catch (e) {
		fetchError = true;
	}
}

const isStudio = project.data.category === "studio";
const imgUrl = project.data.featured_image?.url || `/images/projects/${project.slug}.png`;

const PROJECT_TAGS: Record<string, string[]> = {
	quickcalai: ["Next.js", "TypeScript", "Google Gemini", "Clerk", "Convex", "Postgres"],
	soundkit: ["React", "TypeScript", "Cloudflare Workers", "Durable Objects", "Postgres", "Stripe Connect"],
	gigstax: ["React", "TypeScript", "Cloudflare Workflows", "Gemini Vision", "Polar"],
	"big-brain-shelf": ["Astro", "TypeScript", "Cloudflare Workers", "Workers AI", "Shippo"],
	rallycasts: ["React", "TypeScript", "Cloudflare D1", "Tailwind CSS"],
	parlaypal: ["React", "TypeScript", "Cloudflare", "Tailwind CSS"],
	castlecare: ["React", "TypeScript", "Cloudflare Workers", "Tailwind CSS"],
	deadpartymedia: ["Next.js", "TypeScript", "React Native", "Expo", "Tailwind CSS"],
	rivercitymd: ["React", "TypeScript", "Tailwind CSS", "Stripe"],
	sweettreats: ["TanStack Start", "TypeScript", "Cloudflare D1", "Shippo", "Tailwind CSS"],
	reluxury: ["React", "TypeScript", "Cloudflare Workers", "Tailwind CSS"],
	bigspella: ["React", "TypeScript", "Workers AI", "Tailwind CSS"],
};

const tags = PROJECT_TAGS[project.slug] || (project.taxonomies?.tag || []).map((t: string) => t.toUpperCase());
---

<Base title={`${project.data.title} — cgstewart.dev`}>
	<div class="project-detail-page">
		<nav class="back-nav">
			<a href="/work" class="back-link">
				<span class="back-dash"></span>
				back to projects
			</a>
		</nav>

		<!-- Project Hero Screenshot -->
		<div class="project-hero-shot-wrap">
			<img
				src={imgUrl}
				alt={`${project.data.title} Hero Screenshot`}
				class="project-hero-shot"
				loading="eager"
			/>
		</div>

		<!-- Project Header -->
		<header class="project-header">
			{tags && tags.length > 0 && (
				<div class="tags-line">
					<span class="tags-dash"></span>
					{tags.map((tag: string, i: number) => (
						<span class="tag-item">
							{tag.toUpperCase()}{i < tags.length - 1 ? " ·" : ""}
						</span>
					))}
				</div>
			)}

			<h1 class="project-title">{project.data.title}</h1>

			{project.data.summary && (
				<p class="project-summary">{project.data.summary}</p>
			)}

			<p class="project-byline">
				Built by <span class="studio-highlight">{project.data.client || (isStudio ? "Rocktown Labs" : "Freelance")}</span>.
			</p>
		</header>

		<!-- README / Case Study Body -->
		<main class="readme-container">
			{
				readmeHtml ? (
					<div class="markdown-body" set:html={readmeHtml} />
				) : (
					<div class="fallback-content">
						<h2>Overview</h2>
						<p>{project.data.summary}</p>
						{fetchError && (
							<p class="fetch-note">
								Repository README could not be fetched directly. You can inspect the source code at{" "}
								<a href={`https://github.com/${repo}`} target="_blank" rel="noopener noreferrer">
									github.com/{repo}
								</a>.
							</p>
						)}
					</div>
				)
			}
		</main>

		<!-- Bottom Action Buttons -->
		<footer class="project-bottom-actions">
			{repo && (
				<a
					href={`https://github.com/${repo}`}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-bottom-source"
				>
					View Source Code
				</a>
			)}
			{project.data.live_url && (
				<a
					href={project.data.live_url}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-bottom-live"
				>
					Launch Live Demo &rarr;
				</a>
			)}
		</footer>
	</div>
</Base>

<style>
	.project-detail-page {
		max-width: 780px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 6rem;
	}

	.back-nav {
		margin-bottom: 2rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		color: var(--color-muted);
		font-family: var(--font-heading);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 150ms ease;
	}

	.back-dash {
		display: inline-block;
		width: 1rem;
		height: 1px;
		background: var(--color-muted);
		transition: background-color 150ms ease;
	}

	.back-link:hover {
		color: var(--color-brand);
	}

	.back-link:hover .back-dash {
		background: var(--color-brand);
	}

	/* Hero Screenshot */
	.project-hero-shot-wrap {
		width: 100%;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid var(--color-border);
		background: #000;
		margin-bottom: 2.5rem;
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
	}

	.project-hero-shot {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		object-position: top center;
		display: block;
	}

	/* Project Header */
	.project-header {
		margin-bottom: 2.5rem;
	}

	.tags-line {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 1.25rem;
	}

	.tags-dash {
		display: inline-block;
		width: 2rem;
		height: 1px;
		background: color-mix(in srgb, var(--color-brand) 60%, transparent);
		margin-right: 0.25rem;
	}

	.tag-item {
		font-size: 0.8125rem;
		font-family: var(--font-heading);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-brand);
	}

	.project-title {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 5vw, 4.25rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		margin: 0 0 1.25rem 0;
		color: var(--color-text);
		line-height: 1.1;
	}

	.project-summary {
		font-size: 1.125rem;
		line-height: 1.7;
		color: var(--color-muted);
		margin: 0 0 1rem 0;
	}

	.project-byline {
		font-size: 0.9375rem;
		color: var(--color-muted);
		margin: 0;
	}

	.studio-highlight {
		color: var(--color-text);
		font-weight: 500;
	}

	/* Markdown Body styling */
	.readme-container {
		margin-top: 1.5rem;
		margin-bottom: 3rem;
	}

	.markdown-body {
		color: var(--color-text);
		line-height: 1.75;
		font-size: 1.0625rem;
	}

	.markdown-body :global(h1),
	.markdown-body :global(h2),
	.markdown-body :global(h3),
	.markdown-body :global(h4) {
		font-family: var(--font-heading);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.markdown-body :global(h1) {
		font-size: 2rem;
		margin-top: 3rem;
		margin-bottom: 1.25rem;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 0.5rem;
	}

	.markdown-body :global(h2) {
		font-size: 1.625rem;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 0.5rem;
	}

	.markdown-body :global(h3) {
		font-size: 1.25rem;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
	}

	.markdown-body :global(p) {
		margin-bottom: 1.25rem;
		color: var(--color-muted);
	}

	.markdown-body :global(ul), .markdown-body :global(ol) {
		padding-left: 1.5rem;
		margin-bottom: 1.25rem;
		color: var(--color-muted);
	}

	.markdown-body :global(li) {
		margin-bottom: 0.45rem;
	}

	.markdown-body :global(pre) {
		background: #0d0d0d;
		border: 1px solid var(--color-border);
		padding: 1.25rem 1.5rem;
		border-radius: 8px;
		overflow-x: auto;
		margin: 1.75rem 0;
	}

	.markdown-body :global(code) {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.875em;
		color: var(--color-brand);
	}

	.markdown-body :global(pre code) {
		color: #e4e4e7;
	}

	.markdown-body :global(a) {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.markdown-body :global(strong) {
		color: var(--color-text);
		font-weight: 600;
	}

	.fallback-content {
		padding: 2rem 0;
	}

	.fetch-note {
		margin-top: 1.5rem;
		font-size: 0.875rem;
		color: var(--color-muted);
	}

	.fetch-note a {
		color: var(--color-brand);
	}

	/* Bottom Action Buttons */
	.project-bottom-actions {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 3.5rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--color-border);
	}

	@media (min-width: 640px) {
		.project-bottom-actions {
			flex-direction: row;
		}
	}

	.btn-bottom-source {
		flex: 1;
		padding: 1rem 1.5rem;
		text-align: center;
		font-family: var(--font-heading);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 6px;
		transition: all 150ms ease;
	}

	.btn-bottom-source:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.btn-bottom-live {
		flex: 1;
		padding: 1rem 1.5rem;
		text-align: center;
		font-family: var(--font-heading);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		color: #fff;
		background: var(--color-brand);
		border: 1px solid var(--color-brand);
		border-radius: 6px;
		transition: all 150ms ease;
	}

	.btn-bottom-live:hover {
		opacity: 0.92;
		box-shadow: 0 0 20px color-mix(in srgb, var(--color-brand) 35%, transparent);
	}
</style>
