---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import { marked } from "marked";

const { slug } = Astro.params;

const projectsResult = await getEmDashCollection("projects", {
	limit: 100,
});

const project = (projectsResult.entries || []).find((p) => p.slug === slug || p.id === slug);

if (!project) {
	return Astro.redirect("/work");
}

const repo = project.data.github_repo;
let readmeHtml = "";
let fetchError = false;

if (repo) {
	try {
		// Try 'main' branch first, then 'master'
		let res = await fetch(`https://raw.githubusercontent.com/${repo}/main/README.md`);
		if (!res.ok) {
			res = await fetch(`https://raw.githubusercontent.com/${repo}/master/README.md`);
		}
		if (res.ok) {
			const md = await res.text();
			readmeHtml = await marked.parse(md);
		} else {
			fetchError = true;
		}
	} catch (e) {
		fetchError = true;
	}
}

const isStudio = project.data.category === "studio";
---

<Base title={`${project.data.title} — cgstewart.dev`}>
	<div class="project-detail-page">
		<nav class="back-nav">
			<a href="/work" class="back-link">&larr; Back to all projects</a>
		</nav>

		<!-- Project Header -->
		<header class="project-header">
			<div class="header-meta">
				<span class={`category-tag ${isStudio ? 'tag-studio' : 'tag-client'}`}>
					{isStudio ? "Rocktown Labs Studio" : "Client Work"}
				</span>
				<span class="year-tag">{project.data.year || "2026"}</span>
				{project.data.client && (
					<span class="client-tag">· {project.data.client}</span>
				)}
			</div>

			<h1 class="project-title">
				{project.data.title}<span class="brand-dot">.</span>
			</h1>

			<p class="project-summary">{project.data.summary}</p>

			<div class="action-bar">
				{repo && (
					<a 
						href={`https://github.com/${repo}`} 
						target="_blank" 
						rel="noopener noreferrer"
						class="btn-primary"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
							<path d="M9 18c-4.51 2-5-2-7-2"></path>
						</svg>
						View on GitHub ({repo})
					</a>
				)}
				{project.data.live_url && (
					<a 
						href={project.data.live_url} 
						target="_blank" 
						rel="noopener noreferrer"
						class="btn-secondary"
					>
						<span class="live-dot"></span>
						Launch Live App &rarr;
					</a>
				)}
			</div>

			{project.taxonomies?.tag && (
				<div class="tags-wrap">
					{project.taxonomies.tag.map((t: string) => (
						<span class="tag-pill">#{t}</span>
					))}
				</div>
			)}
		</header>

		<!-- README / Case Study Body -->
		<main class="readme-container">
			<div class="readme-toolbar">
				<div class="readme-tab">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
						<polyline points="14 2 14 8 20 8"></polyline>
					</svg>
					<span>README.md</span>
					<span class="live-sync-badge">Live from GitHub</span>
				</div>
			</div>

			{
				readmeHtml ? (
					<div class="markdown-body" set:html={readmeHtml} />
				) : (
					<div class="fallback-content">
						<h2>Overview</h2>
						<p>{project.data.summary}</p>
						{fetchError && (
							<p class="fetch-note">
								Repository README could not be fetched directly. You can inspect the source code at{" "}
								<a href={`https://github.com/${repo}`} target="_blank" rel="noopener noreferrer">
									github.com/{repo}
								</a>.
							</p>
						)}
					</div>
				)
			}
		</main>
	</div>
</Base>

<style>
	.project-detail-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 2.5rem 1.5rem 6rem;
	}

	.back-nav {
		margin-bottom: 2rem;
	}

	.back-link {
		color: var(--color-muted);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition: color 150ms ease;
	}

	.back-link:hover {
		color: var(--color-brand);
	}

	.project-header {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: 3rem;
	}

	.header-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.category-tag {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.25rem 0.6rem;
		border-radius: 4px;
	}

	.tag-studio {
		background: color-mix(in srgb, var(--color-brand) 15%, transparent);
		color: var(--color-brand);
		border: 1px solid color-mix(in srgb, var(--color-brand) 30%, transparent);
	}

	.tag-client {
		background: color-mix(in srgb, var(--color-accent) 15%, transparent);
		color: var(--color-accent);
		border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
	}

	.year-tag, .client-tag {
		color: var(--color-muted);
		font-size: 0.8125rem;
	}

	.project-title {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: -0.03em;
		margin: 0 0 1rem 0;
		color: var(--color-text);
	}

	.project-summary {
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--color-muted);
		max-width: 800px;
		margin: 0 0 2rem 0;
	}

	.action-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.75rem;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.625rem 1.25rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		color: var(--color-text);
		border-radius: 6px;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 150ms ease;
	}

	.btn-primary:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.btn-secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.625rem 1.25rem;
		background: #10b981;
		color: white;
		border-radius: 6px;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition: opacity 150ms ease;
	}

	.btn-secondary:hover {
		opacity: 0.9;
	}

	.live-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: white;
		display: inline-block;
	}

	.tags-wrap {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag-pill {
		font-family: monospace;
		font-size: 0.75rem;
		color: var(--color-muted);
		background: var(--color-surface);
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		border: 1px solid var(--color-border);
	}

	/* README Container */
	.readme-container {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 10px;
		overflow: hidden;
	}

	.readme-toolbar {
		display: flex;
		align-items: center;
		padding: 0.75rem 1.25rem;
		background: color-mix(in srgb, var(--color-surface) 40%, var(--color-bg));
		border-bottom: 1px solid var(--color-border);
	}

	.readme-tab {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.live-sync-badge {
		font-size: 0.6875rem;
		font-family: monospace;
		color: var(--color-brand);
		background: color-mix(in srgb, var(--color-brand) 12%, transparent);
		padding: 0.15rem 0.4rem;
		border-radius: 4px;
		margin-left: 0.5rem;
	}

	/* Markdown Body styling */
	.markdown-body {
		padding: 2.5rem;
		color: var(--color-text);
		line-height: 1.7;
		font-size: 1rem;
	}

	.markdown-body :global(h1),
	.markdown-body :global(h2),
	.markdown-body :global(h3) {
		font-family: var(--font-heading);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-top: 2rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 0.5rem;
	}

	.markdown-body :global(p) {
		margin-bottom: 1.25rem;
		color: var(--color-muted);
	}

	.markdown-body :global(ul), .markdown-body :global(ol) {
		padding-left: 1.5rem;
		margin-bottom: 1.25rem;
		color: var(--color-muted);
	}

	.markdown-body :global(li) {
		margin-bottom: 0.4rem;
	}

	.markdown-body :global(pre) {
		background: #000;
		border: 1px solid var(--color-border);
		padding: 1.25rem;
		border-radius: 6px;
		overflow-x: auto;
		margin-bottom: 1.5rem;
	}

	.markdown-body :global(code) {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.875em;
		color: var(--color-brand);
	}

	.fallback-content {
		padding: 3rem 2rem;
	}

	.fetch-note {
		margin-top: 1.5rem;
		font-size: 0.875rem;
		color: var(--color-muted);
	}

	.fetch-note a {
		color: var(--color-brand);
	}
</style>
