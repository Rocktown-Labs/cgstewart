---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

const projectsResult = await getEmDashCollection("projects", {
	orderBy: { published_at: "desc" },
});

const projects = projectsResult.entries || [];
const studioProjects = projects.filter(p => p.data.category === "studio");
const clientProjects = projects.filter(p => p.data.category === "client");
---

<Base title="Work & Projects — cgstewart.dev">
	<div class="work-page">
		<header class="work-header">
			<h1 class="page-title">
				Work<span class="brand-dot">.</span>
			</h1>
			<p class="page-desc">
				A comprehensive catalog of startup studio products built through Rocktown Labs, 
				plus production freelance engineering and client deployments.
			</p>

			<!-- Filter Tabs -->
			<div class="filter-tabs">
				<button class="filter-btn active" data-filter="all">
					All ({projects.length})
				</button>
				<button class="filter-btn" data-filter="studio">
					Rocktown Labs Studio ({studioProjects.length})
				</button>
				<button class="filter-btn" data-filter="client">
					Freelance & Client ({clientProjects.length})
				</button>
			</div>
		</header>

		<!-- Projects Grid -->
		<div class="projects-grid">
			{
				projects.map((project) => {
					const isStudio = project.data.category === "studio";
					const imgUrl = project.data.featured_image?.url || `/images/projects/${project.slug}.png`;
					return (
						<article class="card-glow project-card" data-category={project.data.category}>
							<a href={`/work/${project.slug}`} class="card-image-wrap">
								<img
									src={imgUrl}
									alt={project.data.title}
									class="card-image"
									loading="lazy"
								/>
								<div class="card-image-overlay"></div>
							</a>

							<div class="card-body">
								<div class="card-top">
									<div class="card-meta">
										<span class={`category-tag ${isStudio ? 'tag-studio' : 'tag-client'}`}>
											{isStudio ? "Rocktown Labs" : "Client Work"}
										</span>
										<span class="year-tag">{project.data.year || "2026"}</span>
									</div>
									<h2 class="project-title">
										<a href={`/work/${project.slug}`}>{project.data.title}</a>
									</h2>
									<p class="project-summary">{project.data.summary}</p>
								</div>

								<div class="card-bottom">
									{project.taxonomies?.tag && (
										<div class="tags-row">
											{project.taxonomies.tag.map((t: string) => (
												<span class="mini-tag">#{t}</span>
											))}
										</div>
									)}

									<div class="project-links">
										{project.data.github_repo && (
											<a 
												href={`https://github.com/${project.data.github_repo}`} 
												target="_blank" 
												rel="noopener noreferrer"
												class="proj-link"
											>
												<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
													<path d="M9 18c-4.51 2-5-2-7-2"></path>
												</svg>
												GitHub
											</a>
										)}
										{project.data.live_url && (
											<a 
												href={project.data.live_url} 
												target="_blank" 
												rel="noopener noreferrer"
												class="proj-link live-link"
											>
												<span class="live-dot"></span>
												Live Site
											</a>
										)}
										<a href={`/work/${project.slug}`} class="proj-link readme-link">
											README &rarr;
										</a>
									</div>
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</div>
</Base>

<script is:inline>
	const buttons = document.querySelectorAll('.filter-btn');
	const cards = document.querySelectorAll('.project-card');

	buttons.forEach(btn => {
		btn.addEventListener('click', () => {
			buttons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
			const filter = btn.getAttribute('data-filter');

			cards.forEach(card => {
				const cat = card.getAttribute('data-category');
				if (filter === 'all' || cat === filter) {
					card.style.display = 'flex';
				} else {
					card.style.display = 'none';
				}
			});
		});
	});
</script>

<style>
	.work-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 3rem 1.5rem 6rem;
	}

	.work-header {
		margin-bottom: 3rem;
	}

	.page-title {
		font-family: var(--font-heading);
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 800;
		text-transform: uppercase;
		margin: 0 0 0.75rem 0;
		color: var(--color-text);
	}

	.page-desc {
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--color-muted);
		max-width: 720px;
		margin: 0 0 2rem 0;
	}

	.filter-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.filter-btn {
		padding: 0.5rem 1.125rem;
		border-radius: 9999px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-muted);
		font-size: 0.8125rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 150ms ease;
	}

	.filter-btn:hover {
		color: var(--color-text);
		border-color: var(--color-brand);
	}

	.filter-btn.active {
		color: var(--color-text);
		background: var(--color-border);
		border-color: var(--color-brand);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
		gap: 1.75rem;
	}

	.project-card {
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.card-image-wrap {
		display: block;
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		background: #000;
		overflow: hidden;
		border-bottom: 1px solid var(--color-border);
	}

	.card-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform 400ms ease;
	}

	.card-image-wrap:hover .card-image {
		transform: scale(1.03);
	}

	.card-image-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, var(--color-surface) 0%, transparent 45%);
		pointer-events: none;
	}

	.card-body {
		padding: 1.25rem 1.25rem 1rem;
		display: flex;
		flex-direction: column;
		flex: 1;
		justify-content: space-between;
	}

	.card-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.875rem;
	}

	.category-tag {
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
	}

	.tag-studio {
		background: color-mix(in srgb, var(--color-brand) 15%, transparent);
		color: var(--color-brand);
		border: 1px solid color-mix(in srgb, var(--color-brand) 30%, transparent);
	}

	.tag-client {
		background: color-mix(in srgb, var(--color-accent) 15%, transparent);
		color: var(--color-accent);
		border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
	}

	.year-tag {
		font-size: 0.75rem;
		color: var(--color-muted);
		font-family: monospace;
	}

	.project-title {
		font-family: var(--font-heading);
		font-size: 1.375rem;
		font-weight: 700;
		margin: 0 0 0.5rem 0;
	}

	.project-title a {
		color: var(--color-text);
		text-decoration: none;
	}

	.project-title a:hover {
		color: var(--color-brand);
	}

	.project-summary {
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-muted);
		margin: 0 0 1.25rem 0;
	}

	.tags-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.25rem;
	}

	.mini-tag {
		font-size: 0.6875rem;
		font-family: monospace;
		color: var(--color-muted);
	}

	.project-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		border-top: 1px solid var(--color-border);
		padding-top: 0.875rem;
	}

	.proj-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--color-muted);
		padding: 0.3rem 0.65rem;
		border-radius: 4px;
		border: 1px solid var(--color-border);
		transition: all 150ms ease;
	}

	.proj-link:hover {
		color: var(--color-text);
		border-color: var(--color-brand);
	}

	.live-link {
		color: #10b981;
		border-color: color-mix(in srgb, #10b981 30%, transparent);
	}

	.live-link:hover {
		border-color: #10b981;
	}

	.live-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #10b981;
		display: inline-block;
	}

	.readme-link {
		margin-left: auto;
		color: var(--color-brand);
		border-color: transparent;
		background: transparent;
	}

	.readme-link:hover {
		border-color: transparent;
		text-decoration: underline;
	}
</style>
