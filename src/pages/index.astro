---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import TechIcon from "../components/TechIcon";

const [settings, projectsResult, techResult, postsResult] = await Promise.all([
	getSiteSettings(),
	getEmDashCollection("projects", {
		orderBy: { published_at: "desc" },
	}),
	getEmDashCollection("technologies", {
		orderBy: { order: "asc" },
	}),
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
	}),
]);

const projects = projectsResult.entries || [];
const technologies = techResult.entries || [];
const posts = postsResult.entries || [];

// Group tech items by category
const techCategories: Record<string, any[]> = {};
for (const item of technologies) {
	const cat = item.data.category || "General";
	if (!techCategories[cat]) techCategories[cat] = [];
	techCategories[cat].push(item.data);
}

const featuredProjects = projects.filter(p => p.data.featured).slice(0, 6);
---

<Base title="Cameron Stewart · Full Stack Architect & Solo Founder">
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="hero-content">
			<div class="hero-title-wrap">
				<h1 class="hero-name">
					Cameron Stewart<span class="brand-dot">.</span>
				</h1>
				<p class="hero-role">
					<span class="role-line"></span>
					Full Stack Architect & Solo Founder · Rocktown Labs
				</p>
			</div>

			<div class="hero-bio">
				<p>
					I design, build, deploy, and operate production software end to end. Through my studio, <strong class="studio-highlight">Rocktown Labs</strong>, I operate consumer products, multi-agent AI pipelines, and edge-native architectures on Cloudflare and AWS.
				</p>
				<p>
					Currently building and architecting with <span class="tech-highlight">TypeScript</span>, <span class="tech-highlight">React</span>, <span class="tech-highlight">Node.js</span>, and <span class="tech-highlight">Hono</span>, while getting reacquainted with <span class="tech-highlight">C#</span> and <span class="tech-highlight">.NET</span>.
				</p>
			</div>

			<div class="hero-links">
				<a href="https://github.com/cgRGM" target="_blank" rel="noopener noreferrer" class="link-item">
					GitHub &rarr;
				</a>
				<a href="https://linkedin.com/in/camgstewart" target="_blank" rel="noopener noreferrer" class="link-item">
					LinkedIn &rarr;
				</a>
				<a href="/resume" class="btn-resume">
					View Resume
				</a>
			</div>
		</div>
	</section>

	<!-- Tech Arsenal Section -->
	<section id="tech-arsenal" class="arsenal-section">
		<div class="section-heading-wrap">
			<h2 class="section-heading">
				Tech Arsenal<span class="brand-dot">.</span>
			</h2>
			<p class="section-sub">Production technologies powering Rocktown Labs and client systems.</p>
		</div>

		<div class="arsenal-grid">
			{
				Object.entries(techCategories).map(([category, items]) => (
					<div class="arsenal-category">
						<h3 class="category-title">
							<span>{category}</span>
							<span class="category-divider"></span>
						</h3>
						<div class="pills-wrap">
							{items.map((tech) => (
								<div class="tech-pill">
									<TechIcon name={tech.name} icon={tech.icon} size={15} />
									<span>{tech.name}</span>
								</div>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<!-- Featured Work (Studio vs Freelance) -->
	<section id="work" class="work-section">
		<div class="section-heading-wrap work-header">
			<div>
				<h2 class="section-heading">
					Featured Work<span class="brand-dot">.</span>
				</h2>
				<p class="section-sub">Selected products from Rocktown Labs and client engineering.</p>
			</div>
			<a href="/work" class="view-all-link">
				View all projects ({projects.length}) &rarr;
			</a>
		</div>

		<div class="projects-grid">
			{
				featuredProjects.map((project) => {
					const isStudio = project.data.category === "studio";
					const imgUrl = project.data.featured_image?.url || `/images/projects/${project.slug}.png`;
					return (
						<article class="card-glow project-card">
							<a href={`/work/${project.slug}`} class="card-image-wrap">
								<img
									src={imgUrl}
									alt={project.data.title}
									class="card-image"
									loading="lazy"
								/>
								<div class="card-image-overlay"></div>
							</a>

							<div class="card-body">
								<div class="card-top">
									<div class="card-meta">
										<span class={`category-tag ${isStudio ? 'tag-studio' : 'tag-client'}`}>
											{isStudio ? "Rocktown Labs" : "Client Work"}
										</span>
										<span class="year-tag">{project.data.year || "2026"}</span>
									</div>
									<h3 class="project-title">
										<a href={`/work/${project.slug}`}>{project.data.title}</a>
									</h3>
									<p class="project-summary">{project.data.summary}</p>
								</div>

								<div class="card-bottom">
									{project.taxonomies?.tag && (
										<div class="tags-row">
											{project.taxonomies.tag.slice(0, 4).map((t: string) => (
												<span class="mini-tag">#{t}</span>
											))}
										</div>
									)}

									<div class="project-links">
										{project.data.github_repo && (
											<a 
												href={`https://github.com/${project.data.github_repo}`} 
												target="_blank" 
												rel="noopener noreferrer"
												class="proj-link"
											>
												<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
													<path d="M9 18c-4.51 2-5-2-7-2"></path>
												</svg>
												Code
											</a>
										)}
										{project.data.live_url && (
											<a 
												href={project.data.live_url} 
												target="_blank" 
												rel="noopener noreferrer"
												class="proj-link live-link"
											>
												<span class="live-dot"></span>
												Live
											</a>
										)}
										<a href={`/work/${project.slug}`} class="proj-link readme-link">
											README &rarr;
										</a>
									</div>
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</section>

	<!-- Writing Section -->
	{
		posts.length > 0 && (
			<section id="writing" class="writing-section">
				<div class="section-heading-wrap work-header">
					<div>
						<h2 class="section-heading">
							Writing<span class="brand-dot">.</span>
						</h2>
						<p class="section-sub">Articles, architectural notes, and production engineering logs.</p>
					</div>
					<a href="/writing" class="view-all-link">
						All posts &rarr;
					</a>
				</div>

				<div class="posts-list">
					{posts.map((post) => (
						<a href={`/writing/${post.slug}`} class="post-row">
							<div class="post-meta">
								<span class="post-date">{post.data.published_date || "2026"}</span>
							</div>
							<div class="post-main">
								<h3 class="post-title">{post.data.title}</h3>
								<p class="post-summary">{post.data.summary}</p>
							</div>
							<div class="post-arrow">&rarr;</div>
						</a>
					))}
				</div>
			</section>
		)
	}
</Base>

<style>
	/* Hero Section */
	.hero-section {
		position: relative;
		padding: 5rem 1.5rem 4rem;
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	.hero-content {
		position: relative;
		max-width: 800px;
	}

	.hero-name {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.05;
		color: var(--color-text);
		margin: 0 0 0.75rem 0;
		text-transform: uppercase;
	}

	.hero-role {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: clamp(0.9rem, 2vw, 1.125rem);
		color: var(--color-muted);
		font-weight: 500;
		letter-spacing: 0.02em;
		margin: 0 0 2rem 0;
	}

	.role-line {
		width: 2rem;
		height: 2px;
		background: var(--color-brand);
		display: inline-block;
		flex-shrink: 0;
	}

	.hero-bio {
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--color-muted);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 2.25rem;
	}

	.studio-highlight {
		color: var(--color-text);
		font-weight: 600;
	}

	.tech-highlight {
		color: var(--color-brand);
		font-weight: 500;
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
	}

	.link-item {
		color: var(--color-text);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 150ms ease;
	}

	.link-item:hover {
		color: var(--color-brand);
	}

	.btn-resume {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 1.125rem;
		background: var(--color-brand);
		color: white;
		border-radius: 6px;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition: opacity 150ms ease;
	}

	.btn-resume:hover {
		opacity: 0.9;
	}

	/* Section Headings */
	.section-heading-wrap {
		margin-bottom: 2.5rem;
	}

	.section-heading {
		font-family: var(--font-heading);
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		margin: 0 0 0.5rem 0;
		color: var(--color-text);
	}

	.section-sub {
		color: var(--color-muted);
		font-size: 0.9375rem;
		margin: 0;
	}

	/* Arsenal Section */
	.arsenal-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 4rem 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	.arsenal-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		gap: 2rem;
	}

	.arsenal-category {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.category-title {
		font-size: 0.8125rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-brand);
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0;
	}

	.category-divider {
		flex: 1;
		height: 1px;
		background: var(--color-border);
	}

	.pills-wrap {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.pill-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-brand);
		display: inline-block;
	}

	/* Work Section */
	.work-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 4rem 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	.work-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.view-all-link {
		color: var(--color-brand);
		font-weight: 600;
		font-size: 0.875rem;
		text-decoration: none;
	}

	.view-all-link:hover {
		text-decoration: underline;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		gap: 1.5rem;
	}

	.project-card {
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.card-image-wrap {
		display: block;
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		background: #000;
		overflow: hidden;
		border-bottom: 1px solid var(--color-border);
	}

	.card-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform 400ms ease;
	}

	.card-image-wrap:hover .card-image {
		transform: scale(1.03);
	}

	.card-image-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, var(--color-surface) 0%, transparent 45%);
		pointer-events: none;
	}

	.card-body {
		padding: 1.25rem 1.25rem 1rem;
		display: flex;
		flex-direction: column;
		flex: 1;
		justify-content: space-between;
	}

	.card-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.75rem;
	}

	.category-tag {
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
	}

	.tag-studio {
		background: color-mix(in srgb, var(--color-brand) 15%, transparent);
		color: var(--color-brand);
		border: 1px solid color-mix(in srgb, var(--color-brand) 30%, transparent);
	}

	.tag-client {
		background: color-mix(in srgb, var(--color-accent) 15%, transparent);
		color: var(--color-accent);
		border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
	}

	.year-tag {
		font-size: 0.75rem;
		color: var(--color-muted);
		font-family: monospace;
	}

	.project-title {
		font-family: var(--font-heading);
		font-size: 1.375rem;
		font-weight: 700;
		margin: 0 0 0.5rem 0;
	}

	.project-title a {
		color: var(--color-text);
		text-decoration: none;
	}

	.project-title a:hover {
		color: var(--color-brand);
	}

	.project-summary {
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-muted);
		margin: 0 0 1.25rem 0;
	}

	.tags-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1rem;
	}

	.mini-tag {
		font-size: 0.6875rem;
		font-family: monospace;
		color: var(--color-muted);
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		border-top: 1px solid var(--color-border);
		padding-top: 0.875rem;
	}

	.proj-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.75rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--color-muted);
		padding: 0.25rem 0.6rem;
		border-radius: 4px;
		border: 1px solid var(--color-border);
		transition: all 150ms ease;
	}

	.proj-link:hover {
		color: var(--color-text);
		border-color: var(--color-brand);
	}

	.live-link {
		color: #10b981;
		border-color: color-mix(in srgb, #10b981 30%, transparent);
	}

	.live-link:hover {
		border-color: #10b981;
	}

	.live-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #10b981;
		display: inline-block;
	}

	.readme-link {
		margin-left: auto;
		color: var(--color-brand);
		border-color: transparent;
		background: transparent;
	}

	.readme-link:hover {
		border-color: transparent;
		text-decoration: underline;
	}

	/* Writing Section */
	.writing-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 4rem 1.5rem 6rem;
		border-top: 1px solid var(--color-border);
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.post-row {
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		border-radius: 8px;
		text-decoration: none;
		transition: all 150ms ease;
	}

	.post-row:hover {
		border-color: var(--color-brand);
		transform: translateX(4px);
	}

	.post-date {
		font-family: monospace;
		font-size: 0.8125rem;
		color: var(--color-muted);
		min-width: 90px;
	}

	.post-main {
		flex: 1;
	}

	.post-title {
		font-family: var(--font-heading);
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-text);
		margin: 0 0 0.25rem 0;
	}

	.post-summary {
		font-size: 0.875rem;
		color: var(--color-muted);
		margin: 0;
		line-height: 1.5;
	}

	.post-arrow {
		color: var(--color-brand);
		font-size: 1.25rem;
		font-weight: 700;
	}

	@media (max-width: 640px) {
		.hero-section {
			padding: 2.5rem 1.125rem 2.5rem;
		}

		.hero-role {
			font-size: 0.9375rem;
			margin-bottom: 1.5rem;
		}

		.hero-bio {
			font-size: 1rem;
			margin-bottom: 1.75rem;
		}

		.arsenal-section,
		.work-section,
		.writing-section {
			padding: 2.75rem 1.125rem;
		}

		.section-heading-wrap {
			margin-bottom: 1.75rem;
		}

		.post-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
			padding: 1.125rem;
		}

		.post-arrow {
			display: none;
		}
	}
</style>
